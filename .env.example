# Meta Model API key from https://dev.meta.ai  (keep secret; never commit .env)
MODEL_API_KEY=LLM_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides
META_BASE_URL=https://api.meta.ai/v1
VERITAS_TEXT_MODEL=muse-spark-1.3
VERITAS_MAX_ITERS=4
VERITAS_BUDGET_USD=5.0

# Optional: inference partner (Baseten) for hybrid critic routing (--partner)
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=openai/gpt-oss-120b
